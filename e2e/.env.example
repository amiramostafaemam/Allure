# Only needed for the authenticated-checkout spec — see e2e/README.md.
# CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY: same dev-instance keys backend/.env
# and frontend/.env already use (must be a Clerk *development* instance, pk_test_/sk_test_).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# A dedicated test account using Clerk's +clerk_test convention (see README) —
# not a real user's credentials. The password just needs to satisfy Clerk's
# password policy; the email's OTP is fixed to 424242 by Clerk itself.
E2E_TEST_EMAIL=you+clerk_test@example.com
E2E_TEST_PASSWORD=
