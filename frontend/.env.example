# Backend origin — empty in production (same-domain Docker build), but in
# local dev the frontend (5173) and backend (3001) run on different ports.
VITE_API_URL=http://localhost:3001

VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# Optional — Sentry error tracking in the browser
VITE_SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.YOUR_REGION.sentry.io/YOUR_PROJECT_ID

# Must match the backend's IMAGEKIT_URL_ENDPOINT — used to detect which
# image URLs can get ImageKit transforms applied.
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
