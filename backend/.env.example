PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=require

FRONTEND_URL=http://localhost:5173

CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.YOUR_REGION.sentry.io/YOUR_PROJECT_ID

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

IMAGEKIT_PUBLIC_KEY=public_YOUR_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# POLAR_ACCESS_TOKEN and POLAR_WEBHOOK_SECRET are optional — checkout returns
# 503 without them, but the server still boots. POLAR_CHECKOUT_PRODUCT_ID is
# required (must be a real product UUID from your Polar dashboard) even in dev.
POLAR_ACCESS_TOKEN=polar_YOUR_ACCESS_TOKEN
POLAR_WEBHOOK_SECRET=whsec_YOUR_POLAR_WEBHOOK_SECRET
POLAR_API_BASE=https://api.polar.sh
POLAR_CHECKOUT_PRODUCT_ID=00000000-0000-0000-0000-000000000000
